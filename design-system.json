        },
        "lg": {
          "padding": "px-8 py-4",
          "fontSize": "text-body",
          "iconSize": "h-5 w-5"
        }
      },
      "iconPlacement": {
        "left": "Icon before text",
        "right": "Icon after text (default)"
      }
    },
