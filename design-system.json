        },
        "bordered": {
          "background": "#FFFFFF",
          "border": "1px solid rgba(226, 232, 240, 0.6)",
          "padding": "p-8",
          "borderRadius": "rounded-[28px]",
          "usage": "Cards without shadow",
          "component": "Card variant='bordered'"
        }
      },
      "padding": {
        "sm": "p-5",
        "md": "p-8",
        "lg": "p-12"
      }
    },
    "iconBadge": {
