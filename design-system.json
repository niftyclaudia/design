{
  "meta": {
    "name": "Mopac Design System",
    "version": "1.0.0",
    "description": "Comprehensive design system for Mopac AI agent platform. This file serves as a complete reference for AI agents building new features.",
    "lastUpdated": "2024-12-19"
  },
  "designPrinciples": {
    "philosophy": "Calm, confident, modern—mix of soft gradients and high-contrast dark panels. Expert yet approachable voice.",
    "coreValues": [
      "Trustworthy and reliable",
      "Modern and professional",
      "Accessible and clear",
      "Consistent and scalable"
    ],
    "usageGuidelines": [
      "Always use design tokens from this system—never hardcode colors or spacing",
      "Maintain consistent spacing using the 8px base unit",
      "Use semantic color names (brand, ink, slate) not hex values",
      "Follow typography scale for hierarchy",
      "Apply consistent border radius values",
      "Use shadows to create depth hierarchy"
    ]
  },
  "typography": {
    "fontFamilies": {
      "display": {
        "family": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"],
        "usage": "Headlines, hero text, section titles, card titles",
        "weights": [400, 500, 600, 700],
        "css": "font-display"
      },
      "body": {
        "family": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"],
        "usage": "Body copy, descriptions, general text",
        "weights": [300, 400, 500, 600],
        "css": "font-body"
      },
      "mono": {
        "family": ["IBM Plex Mono", "Menlo", "Monaco", "monospace"],
        "usage": "Labels, metrics, code snippets, technical text",
        "weights": [400],
        "css": "font-mono"
      }
    },
    "typeScale": {
      "hero": {
        "size": "clamp(2.5rem, 5vw, 4.5rem)",
        "lineHeight": 1.1,
        "letterSpacing": "-0.03em",
        "fontWeight": 600,
        "usage": "Main hero headline on landing page",
        "css": "text-hero",
        "component": "Hero"
      },
      "h1": {
        "size": "clamp(2rem, 4vw, 3.5rem)",
        "lineHeight": 1.15,
        "letterSpacing": "-0.02em",
        "fontWeight": 600,
        "usage": "Page titles, major section headers",
        "css": "text-h1",
        "component": "H1"
      },
      "h2": {
        "size": "clamp(1.75rem, 3vw, 2.75rem)",
        "lineHeight": 1.2,
        "letterSpacing": "-0.02em",
        "fontWeight": 600,
        "usage": "Section headers, card group titles",
        "css": "text-h2",
        "component": "H2"
      },
      "h3": {
        "size": "clamp(1.5rem, 2.5vw, 2rem)",
        "lineHeight": 1.3,
        "letterSpacing": "-0.01em",
        "fontWeight": 600,
        "usage": "Card titles, subsection headers",
        "css": "text-h3",
        "component": "H3"
      },
      "body-lg": {
        "size": "1.25rem",
        "lineHeight": 1.7,
        "letterSpacing": "-0.01em",
        "fontWeight": 300,
        "usage": "Large body text, hero descriptions, important paragraphs",
        "css": "text-body-lg",
        "component": "BodyLarge"
      },
      "body": {
        "size": "1.125rem",
        "lineHeight": 1.7,
        "letterSpacing": "-0.01em",
        "fontWeight": 400,
        "usage": "Standard body text, card descriptions",
        "css": "text-body",
        "component": "Body"
      },
      "body-sm": {
        "size": "1rem",
        "lineHeight": 1.6,
        "letterSpacing": "-0.005em",
        "fontWeight": 400,
        "usage": "Small body text, captions, metadata",
        "css": "text-body-sm",
        "component": "BodySmall"
      },
      "caption": {
        "size": "0.875rem",
        "lineHeight": 1.5,
        "letterSpacing": "0.01em",
        "fontWeight": 400,
        "usage": "Fine print, disclaimers, timestamps",
        "css": "text-caption",
        "component": "Caption"
      },
      "label": {
        "size": "0.75rem",
        "lineHeight": 1.5,
        "letterSpacing": "0.2em",
        "fontWeight": 500,
        "textTransform": "uppercase",
        "fontFamily": "mono",
        "usage": "Section labels, category tags, metadata labels",
        "css": "font-mono text-xs uppercase tracking-[0.2em] font-medium",
        "component": "Label"
      }
    },
    "fontSettings": {
      "textRendering": "optimizeLegibility",
      "fontSmoothing": "antialiased",
      "fontSynthesis": "none",
      "fontFeatureSettings": "'kern' 1, 'liga' 1"
    }
  },
  "colors": {
    "semantic": {
      "surface": {
        "value": "#FFFFFF",
        "usage": "Primary background, card backgrounds, main content areas",
        "css": "bg-surface"
      },
      "surface-muted": {
        "value": "#FAFBFC",
        "usage": "Secondary backgrounds, nested cards, subtle sections",
        "css": "bg-surface-muted"
      },
      "ink": {
        "value": "#0F172A",
        "usage": "Primary text color, dark text on light backgrounds",
        "css": "text-ink"
      },
      "slate": {
        "value": "#64748B",
        "usage": "Secondary text, muted text, metadata",
        "css": "text-slate",
        "opacityVariants": {
          "80": "text-slate/80",
          "70": "text-slate/70",
          "60": "text-slate/60"
        }
      },
      "border": {
        "value": "#E2E8F0",
        "usage": "Card borders, dividers, input borders",
        "css": "border-border",
        "opacityVariants": {
          "60": "border-border/60"
        }
      },
      "brand": {
        "value": "#FF6B35",
        "usage": "Primary brand color, CTAs, accents, interactive elements",
        "css": "bg-brand or text-brand"
      },
      "brand-hover": {
        "value": "#F15520",
        "usage": "Hover state for brand-colored buttons and links",
        "css": "bg-brand-hover"
      },
      "highlight": {
        "value": "#C8FF5A",
        "usage": "Highlight color, success states, positive metrics",
        "css": "bg-highlight"
      },
      "night": {
        "value": "#0A0F1C",
        "usage": "Dark section backgrounds, premium sections",
        "css": "bg-night"
      },
      "midnight": {
        "value": "#0F172A",
        "usage": "Darkest backgrounds, footer sections",
        "css": "bg-midnight"
      }
    },
    "dataVisualization": {
      "seriesA": {
        "value": "#4C6FFF",
        "usage": "Primary chart color, first data series",
        "css": "text-[#4C6FFF]"
      },
      "seriesB": {
        "value": "#FF67B0",
        "usage": "Secondary chart color, second data series"
      },
      "seriesC": {
        "value": "#20C9A8",
        "usage": "Tertiary chart color, success metrics, positive indicators",
        "css": "text-[#20C9A8]"
      },
      "seriesD": {
        "value": "#FCCD4D",
        "usage": "Quaternary chart color, warning states"
      }
    },
    "gradients": {
      "hero-gradient": {
        "value": "linear-gradient(180deg, #FFFFFF 0%, #FFE2C4 100%)",
        "usage": "Hero section background, landing page header",
        "css": "bg-hero-gradient"
      },
      "text-gradient": {
        "value": "linear-gradient(to right, #0F172A, #FF6B35)",
        "usage": "Gradient text effects, hero text highlights",
        "css": "bg-gradient-to-r from-ink to-brand bg-clip-text text-transparent"
      }
    },
    "usageRules": {
      "textOnLight": "Use 'ink' for primary text, 'slate' with opacity for secondary",
      "textOnDark": "Use 'text-white' with opacity variants (text-white/80, text-white/60)",
      "borders": "Use 'border-border' or 'border-border/60' for subtle borders",
      "brandUsage": "Reserve brand color for CTAs, active states, and key interactive elements",
      "contrast": "Ensure WCAG AA contrast ratios: 4.5:1 for body text, 3:1 for large text"
    }
  },
  "spacing": {
    "baseUnit": 8,
    "scale": {
      "0": "0px",
      "0.5": "0.125rem",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "18": "4.5rem",
      "20": "5rem",
      "22": "5.5rem",
      "24": "6rem",
      "26": "6.5rem",
      "30": "7.5rem"
    },
    "sectionSpacing": {
      "hero": "160px (mt-20)",
      "standard": "112px (py-24)",
      "dense": "72px (py-18)",
      "compact": "48px (py-12)"
    },
    "componentSpacing": {
      "cardPadding": {
        "sm": "20px 24px (p-5)",
        "md": "32px (p-8)",
        "lg": "48px (p-12)"
      },
      "buttonPadding": {
        "sm": "10px 20px (px-5 py-2.5)",
        "md": "24px 24px (px-6 py-3)",
        "lg": "32px 32px (px-8 py-4)"
      },
      "tagPadding": "10px 20px (px-5 py-2.5)"
    }
  },
  "borderRadius": {
    "pill": {
      "value": "999px",
      "usage": "Buttons, tags, chips, fully rounded elements",
      "css": "rounded-full"
    },
    "card": {
      "value": "28px",
      "usage": "Cards, containers, main content blocks",
      "css": "rounded-[28px]"
    },
    "card-xl": {
      "value": "32px",
      "usage": "Large cards, hero input containers",
      "css": "rounded-[32px]"
    },
    "badge": {
      "value": "16px",
      "usage": "Icon badges, small containers",
      "css": "rounded-2xl"
    },
    "badge-sm": {
      "value": "12px",
      "usage": "Small icon containers",
      "css": "rounded-xl"
    }
  },
  "shadows": {
    "hero": {
      "value": "0 24px 64px rgba(9, 18, 41, 0.12)",
      "usage": "Hero input cards, prominent elevated elements",
      "css": "shadow-hero"
    },
    "card": {
      "value": "0 16px 48px rgba(9, 18, 41, 0.06)",
      "usage": "Standard cards, elevated content",
      "css": "shadow-card"
    },
    "cta": {
      "value": "0 8px 24px rgba(255, 107, 53, 0.28)",
      "usage": "Primary buttons, brand-colored CTAs",
      "css": "shadow-cta"
    }
  },
  "components": {
    "button": {
      "variants": {
        "primary": {
          "background": "#FF6B35",
          "text": "#FFFFFF",
          "shadow": "shadow-cta",
          "hover": {
            "background": "#F15520",
            "transform": "none"
          },
          "padding": "px-6 py-3",
          "borderRadius": "rounded-full",
          "fontSize": "text-body-sm",
          "fontWeight": "font-medium",
          "usage": "Main CTAs, primary actions",
          "component": "Button variant='primary'"
        },
        "secondary": {
          "background": "transparent",
          "border": "1px solid rgba(255, 255, 255, 0.3)",
          "text": "rgba(255, 255, 255, 0.8)",
          "hover": {
            "border": "rgba(255, 255, 255, 0.5)",
            "background": "rgba(255, 255, 255, 0.05)"
          },
          "padding": "px-6 py-3",
          "borderRadius": "rounded-full",
          "fontSize": "text-body-sm",
          "fontWeight": "font-medium",
          "usage": "Secondary actions on dark backgrounds",
          "component": "Button variant='secondary'"
        },
        "ghost": {
          "background": "rgba(255, 255, 255, 0.15)",
          "border": "1px solid rgba(255, 255, 255, 0.5)",
          "text": "#0F172A",
          "backdrop": "backdrop-blur-sm",
          "hover": {
            "background": "rgba(255, 255, 255, 0.25)"
          },
          "padding": "px-5 py-2.5",
          "borderRadius": "rounded-full",
          "fontSize": "text-body-sm",
          "fontWeight": "font-medium",
          "usage": "Tertiary actions, navigation buttons",
          "component": "Button variant='ghost'"
        },
        "outline": {
          "background": "transparent",
          "border": "1px solid #E2E8F0",
          "text": "#0F172A",
          "hover": {
            "background": "#FAFBFC"
          },
          "padding": "px-5 py-2",
          "borderRadius": "rounded-full",
          "fontSize": "text-body-sm",
          "fontWeight": "font-medium",
          "usage": "Secondary actions on light backgrounds",
          "component": "Button variant='outline'"
        },
        "highlight": {
          "background": "#8B5CF6",
          "text": "#FFFFFF",
          "hover": {
            "background": "rgba(139, 92, 246, 0.9)"
          },
          "padding": "px-6 py-3",
