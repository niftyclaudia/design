  "layout": {
    "container": {
      "maxWidth": "1152px (max-w-6xl)",
      "padding": "24px (px-6)",
      "margin": "0 auto (mx-auto)"
    },
    "grid": {
      "columns": {
        "mobile": 1,
        "tablet": 2,
        "desktop": 3,
        "large": 4
      },
      "gap": {
        "sm": "24px (gap-6)",
        "md": "32px (gap-8)",
        "lg": "48px (gap-12)"
      }
    },
    "sections": {
      "hero": {
        "padding": "pt-10 pb-24",
        "background": "bg-hero-gradient",
        "overlay": "Absolute positioned blur gradient for depth"
      },
      "standard": {
        "padding": "py-24",
        "spacing": "max-w-6xl mx-auto px-6"
      },
      "ctaBar": {
        "background": "#0F172A (bg-midnight)",
        "padding": "px-10 py-8",
        "borderRadius": "rounded-full",
        "shadow": "shadow-card",
        "layout": "flex flex-col gap-6 md:flex-row md:items-center md:justify-between"
      }
    }
  },
  "effects": {
    "transitions": {
      "default": "transition-all",
      "duration": "200-300ms",
      "easing": "ease-in-out"
    },
    "hover": {
      "cards": {
        "transform": "none (or scale-101)",
        "shadow": "shadow-card (enhanced)"
      },
      "tags": {
        "transform": "translateY(-2px)",
        "shadow": "shadow-card"
      },
      "buttons": {
        "background": "Hover state color",
        "transform": "none"
      }
    },
    "gradients": {
      "heroBlur": {
        "position": "absolute inset-x-0 top-20",
        "size": "h-64 w-[60rem]",
        "blur": "blur-3xl",
        "opacity": "opacity-40",
        "gradient": "from-[#8B5CF6] via-white to-[#FF6B35]"
      }
    }
  },
  "responsive": {
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px"
    },
    "patterns": {
      "navigation": "Hidden on mobile (hidden md:flex)",
      "grid": "1 column mobile, 2-3 columns desktop",
      "spacing": "Reduced padding on mobile (px-6 → px-4)"
    }
  },
  "accessibility": {
    "contrast": {
      "minimum": "WCAG AA (4.5:1 for body text, 3:1 for large text)",
      "recommended": "WCAG AAA where possible"
    },
    "focus": {
      "outline": "Browser default or custom focus ring",
      "visible": "Always ensure focus is visible"
    },
    "semantic": {
      "headings": "Use proper heading hierarchy (h1 → h2 → h3)",
      "buttons": "Use button elements for interactive actions",
      "labels": "Always associate labels with form inputs"
    }
  },
  "implementation": {
    "componentLocation": "app/src/components/",
    "exports": "All components exported from app/src/components/index.ts",
    "usage": "Import components: import { Button, Card, Tag } from '@/components'",
    "styling": "Tailwind CSS with custom design tokens",
    "configFile": "app/tailwind.config.js"
  },
  "examples": {
    "buttonPrimary": {
      "code": "<Button variant='primary'>Start building</Button>",
      "description": "Main CTA button"
    },
    "buttonWithIcon": {
      "code": "<Button variant='ghost' icon={MessageSquare}>Support</Button>",
      "description": "Button with left icon"
    },
    "tagInteractive": {
      "code": "<Tag icon={LayoutDashboard} onClick={handleClick}>Reporting Dashboard</Tag>",
      "description": "Interactive suggestion chip"
    },
    "cardWorkflow": {
      "code": "<Card variant='default' padding='md'><IconBadge icon={Sparkles} /><H3>Design</H3><BodySmall>Description</BodySmall></Card>",
      "description": "Workflow step card"
    },
